<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-broken fixture for check.mjs. It breaks rule 3 and rule 9 on purpose. -->
<!-- Edge "bad-target" ends on the layer 1 band, not on a class. -->
<!-- Edge "bad-diamond" is an aggregation from layer 2 to layer 1. -->
<!-- Edge "bad-crossing" has explicit points, but its straight segment runs through the GameStore box. -->
<mxfile host="drawio-clases" compressed="false">
  <diagram id="all-classes" name="All classes">
    <mxGraphModel grid="1" gridSize="10" page="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <object id="legend" label="LEGEND" role="legend">
          <mxCell style="rounded=0;html=1;container=1;" vertex="1" parent="1">
            <mxGeometry x="0" y="0" width="300" height="80" as="geometry"/>
          </mxCell>
        </object>
        <object id="legend-use" label="use" role="legend-line" kind="use">
          <mxCell style="text;html=1;" vertex="1" parent="legend">
            <mxGeometry x="10" y="20" width="200" height="20" as="geometry"/>
          </mxCell>
        </object>
        <object id="legend-aggregation" label="aggregation" role="legend-line" kind="aggregation">
          <mxCell style="text;html=1;" vertex="1" parent="legend">
            <mxGeometry x="10" y="40" width="200" height="20" as="geometry"/>
          </mxCell>
        </object>
        <object id="legend-implements" label="implements" role="legend-line" kind="implements">
          <mxCell style="text;html=1;" vertex="1" parent="legend">
            <mxGeometry x="160" y="20" width="120" height="20" as="geometry"/>
          </mxCell>
        </object>
        <object id="legend-code" label="code" role="legend-box" kind="code">
          <mxCell style="text;html=1;" vertex="1" parent="legend">
            <mxGeometry x="10" y="60" width="200" height="20" as="geometry"/>
          </mxCell>
        </object>
        <object id="band-2" label="LAYER 2 · USE CASES" role="band" layer="2">
          <mxCell style="rounded=0;html=1;container=1;fillColor=#efe7f8;strokeColor=#7e22ce;" vertex="1" parent="1">
            <mxGeometry x="0" y="100" width="900" height="200" as="geometry"/>
          </mxCell>
        </object>
        <object id="type-PlayGame" label="&lt;b&gt;PlayGame&lt;/b&gt;&lt;hr&gt;- store: GameStore&lt;hr&gt;+ execute(request: MoveRequest): Promise&amp;lt;Outcome&amp;gt;" role="class" typeId="PlayGame" kind="class" status="code" layer="2">
          <mxCell style="rounded=0;html=1;overflow=fill;" vertex="1" parent="band-2">
            <mxGeometry x="40" y="50" width="320" height="80" as="geometry"/>
          </mxCell>
        </object>
        <object id="type-GameStore" label="&lt;b&gt;GameStore&lt;/b&gt;&lt;hr&gt;&lt;hr&gt;+ load(id: string): Promise&amp;lt;string | null&amp;gt;&lt;br&gt;+ save(id: string, data: string): Promise&amp;lt;void&amp;gt;" role="class" typeId="GameStore" kind="interface" status="code" layer="2">
          <mxCell style="rounded=0;html=1;overflow=fill;" vertex="1" parent="band-2">
            <mxGeometry x="400" y="50" width="200" height="80" as="geometry"/>
          </mxCell>
        </object>
        <object id="type-UseCase" label="&lt;b&gt;UseCase&lt;/b&gt;&lt;hr&gt;&lt;hr&gt;+ execute(request: TReq): Promise&amp;lt;TRes&amp;gt;" role="class" typeId="UseCase" kind="interface" status="code" layer="2">
          <mxCell style="rounded=0;html=1;overflow=fill;" vertex="1" parent="band-2">
            <mxGeometry x="660" y="50" width="200" height="80" as="geometry"/>
          </mxCell>
        </object>
        <object id="band-1" label="LAYER 1 · ENTITIES" role="band" layer="1">
          <mxCell style="rounded=0;html=1;container=1;fillColor=#f9f4dc;strokeColor=#b45309;" vertex="1" parent="1">
            <mxGeometry x="0" y="330" width="600" height="200" as="geometry"/>
          </mxCell>
        </object>
        <object id="type-Engine" label="&lt;b&gt;Engine&lt;/b&gt;&lt;hr&gt;- phase: Phase&lt;hr&gt;+ play(move: Move): Outcome&lt;br&gt;+ undo(): void&lt;br&gt;+ redo(): void" role="class" typeId="Engine" kind="class" status="code" layer="1">
          <mxCell style="rounded=0;html=1;overflow=fill;" vertex="1" parent="band-1">
            <mxGeometry x="40" y="50" width="240" height="110" as="geometry"/>
          </mxCell>
        </object>
        <mxCell id="bad-target" value="store 1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;" edge="1" parent="1" source="type-PlayGame" target="band-1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="bad-diamond" value="engine 1" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=diamondThin;startFill=0;endArrow=none;" edge="1" parent="1" source="type-PlayGame" target="type-Engine">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="bad-crossing" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=0;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="type-PlayGame" target="type-UseCase">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="510" y="190"/>
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
